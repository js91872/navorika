export default function HeicToJpgPage() {
  const meta = tools.find(t => t.slug === 'heic-to-jpg');
  return (
    <EnhancedToolWrapper meta={meta}>
      <HeicToJpgPageContent />
    </EnhancedToolWrapper>
  );
}
